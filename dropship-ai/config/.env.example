# ═══ STORE PLATFORM ═══════════════════════════════════════════
# Choose: tiktok | shopify | woocommerce | square
STORE_PLATFORM=tiktok

# ═══ TikTok Shop (FREE — recommended for $0 start) ══════════
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=

# ═══ Shopify (optional — $39/mo) ═════════════════════════════
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-01

# ═══ WooCommerce (FREE — self-hosted) ════════════════════════
WOO_STORE_URL=https://your-site.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# ═══ AI (you already have Claude Code — use that) ════════════
# Only needed if running scripts standalone outside Claude Code
ANTHROPIC_API_KEY=

# ═══ Supplier (all FREE to join) ═════════════════════════════
# CJDropshipping — 100% free, pay per order only
# EPROLO — free Shopify/TikTok app
# AliExpress — free, manual ordering to start
