{
  "name": "YouTube Autopilot",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 460]
    },
    {
      "parameters": {
        "command": "cd /d \"C:\\Users\\micha\\OneDrive\\Desktop\\code\\youtube-autopilot\" && python main.py 2>&1"
      },
      "id": "run-autopilot",
      "name": "Run YouTube Autopilot",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "check-success",
              "leftValue": "={{ $json.exitCode }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "id": "check-result",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 380]
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.stdout || '';\nconst match = output.match(/https:\\/\\/www\\.youtube\\.com\\/watch\\?v=([\\w-]+)/);\nreturn [{ json: { success: true, video_url: match ? match[0] : 'unknown', output } }];"
      },
      "id": "parse-result",
      "name": "Parse Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 280]
    },
    {
      "parameters": {
        "jsCode": "const err = $input.first().json.stderr || $input.first().json.stdout || 'Unknown error';\nconsole.error('YouTube Autopilot failed:', err);\nreturn [{ json: { success: false, error: err } }];"
      },
      "id": "log-error",
      "name": "Log Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 480]
    }
  ],
  "connections": {
    "Daily 9am": {
      "main": [[{ "node": "Run YouTube Autopilot", "type": "main", "index": 0 }]]
    },
    "Manual Trigger": {
      "main": [[{ "node": "Run YouTube Autopilot", "type": "main", "index": 0 }]]
    },
    "Run YouTube Autopilot": {
      "main": [[{ "node": "Success?", "type": "main", "index": 0 }]]
    },
    "Success?": {
      "main": [
        [{ "node": "Parse Result", "type": "main", "index": 0 }],
        [{ "node": "Log Error", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
